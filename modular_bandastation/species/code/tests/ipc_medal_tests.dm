/// Exercise the real pinning delay while a mantle already occupies the neck slot.
/datum/unit_test/ipc_medal_award/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	var/mob/living/carbon/human/pinner = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/clothing/neck/cloak/cap/mantle = allocate(__IMPLIED_TYPE__)
	TEST_ASSERT(ipc.equip_to_slot_if_possible(mantle, ITEM_SLOT_NECK), "The IPC could not wear its existing captain's mantle.")
	var/obj/item/clothing/accessory/medal/medal = allocate(__IMPLIED_TYPE__)
	var/commendations_before = length(GLOB.commendations)
	ipc_test_pin_medal(medal, ipc, pinner)
	var/obj/item/bodypart/chest = ipc.get_bodypart(BODY_ZONE_CHEST)
	var/datum/component/ipc_medals/mount = ipc.GetComponent(/datum/component/ipc_medals)
	TEST_ASSERT(mount && medal.loc == chest, "The real pinning flow did not attach a medal to the bare IPC's chest.")
	TEST_ASSERT_NULL(ipc.w_uniform, "Pinning a medal fabricated a uniform.")
	TEST_ASSERT_EQUAL(ipc.wear_neck, mantle, "Pinning a medal replaced the captain's mantle.")
	TEST_ASSERT_EQUAL(medal.awarded_to, ipc.real_name, "The chassis medal did not record its recipient.")
	TEST_ASSERT_EQUAL(medal.awarder, pinner.real_name, "The chassis medal did not record its awarder.")
	TEST_ASSERT_EQUAL(length(GLOB.commendations), commendations_before + 1, "The chassis award was not recorded exactly once.")
	var/found_medal = FALSE
	for(var/image/part_image as anything in chest.get_limb_icon())
		if(part_image.icon == medal.worn_icon && part_image.icon_state == medal.icon_state)
			found_medal = TRUE
	TEST_ASSERT(found_medal, "The physical chest's generated images omit its pinned medal.")
	ADD_TRAIT(medal, TRAIT_NO_STRIP, TRAIT_SOURCE_UNIT_TESTS)
	TEST_ASSERT(!mount.remove_medal(medal, pinner), "A no-strip medal could be removed through the chassis link.")
	REMOVE_TRAIT(medal, TRAIT_NO_STRIP, TRAIT_SOURCE_UNIT_TESTS)
	TEST_ASSERT(mount.remove_medal(medal, pinner), "A pinned medal could not be removed through its actual removal flow.")
	TEST_ASSERT(pinner.is_holding(medal), "Removing the medal failed to put the physical item in the user's hands.")
	TEST_ASSERT_EQUAL(length(mount.medals), 0, "Removing the medal left a phantom chassis attachment.")
	ipc_test_pin_medal(medal, ipc, pinner)
	TEST_ASSERT_EQUAL(length(GLOB.commendations), commendations_before + 1, "Re-pinning an awarded medal duplicated the commendation.")
	GLOB.commendations.Cut(commendations_before + 1)

/// Organic recipients still need a uniform; the usual uniform path keeps working.
/datum/unit_test/ipc_medal_uniform_controls/Run()
	var/mob/living/carbon/human/recipient = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/pinner = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/clothing/accessory/medal/medal = allocate(__IMPLIED_TYPE__)
	var/commendations_before = length(GLOB.commendations)
	ipc_test_pin_medal(medal, recipient, pinner)
	TEST_ASSERT(pinner.is_holding(medal), "A medal was attached directly to an organic recipient without a uniform.")
	TEST_ASSERT_NULL(medal.awarded_to, "A failed pinning attempt recorded an award.")
	var/obj/item/clothing/under/color/grey/uniform = allocate(__IMPLIED_TYPE__)
	TEST_ASSERT(recipient.equip_to_slot_if_possible(uniform, ITEM_SLOT_ICLOTHING), "Could not equip the control recipient's uniform.")
	ipc_test_pin_medal(medal, recipient, pinner)
	TEST_ASSERT_EQUAL(medal.loc, uniform, "The ordinary uniform pinning path stopped working.")
	TEST_ASSERT(medal in uniform.attached_accessories, "The uniform lost its physical attached medal.")
	TEST_ASSERT_EQUAL(medal.awarded_to, recipient.real_name, "The ordinary award did not record its recipient.")
	TEST_ASSERT_EQUAL(length(GLOB.commendations), commendations_before + 1, "The ordinary award was not recorded exactly once.")
	GLOB.commendations.Cut(commendations_before + 1)

/// Multiple awards obey the uniform limit and leave no phantom item or overlay on lifecycle changes.
/datum/unit_test/ipc_medal_lifecycle/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	var/mob/living/carbon/human/pinner = allocate(/mob/living/carbon/human/consistent)
	var/commendations_before = length(GLOB.commendations)
	var/list/awards = list()
	for(var/index in 1 to /obj/item/clothing/under::max_number_of_accessories + 1)
		var/obj/item/clothing/accessory/medal/medal = allocate(__IMPLIED_TYPE__)
		awards += medal
		ipc_test_pin_medal(medal, ipc, pinner)
	var/datum/component/ipc_medals/mount = ipc.GetComponent(/datum/component/ipc_medals)
	var/obj/item/bodypart/chest = ipc.get_bodypart(BODY_ZONE_CHEST)
	TEST_ASSERT_EQUAL(length(mount.medals), /obj/item/clothing/under::max_number_of_accessories, "Additional awards replaced previous medals or exceeded the ordinary accessory limit.")
	TEST_ASSERT(pinner.is_holding(awards[length(awards)]), "The over-limit medal left the pinner's hands.")
	qdel(awards[1])
	TEST_ASSERT_EQUAL(length(mount.medals), /obj/item/clothing/under::max_number_of_accessories - 1, "Deleting a medal left a phantom attachment.")
	var/obj/item/clothing/accessory/medal/moved = awards[2]
	moved.forceMove(ipc.drop_location())
	TEST_ASSERT(!(moved in mount.medals), "Moving a medal out of the chest left a phantom attachment.")
	ipc.death()
	TEST_ASSERT_EQUAL(length(mount.medals), /obj/item/clothing/under::max_number_of_accessories - 2, "Death destroyed the corpse's awards.")
	ipc.set_species(/datum/species/human)
	TEST_ASSERT(QDELETED(mount), "Changing species retained the old chassis medal component.")
	for(var/obj/item/clothing/accessory/medal/medal as anything in awards)
		if(!QDELETED(medal))
			TEST_ASSERT(medal.loc != chest, "Changing species left a medal trapped inside the old chest.")
	var/mob/living/carbon/human/other_ipc = allocate(/mob/living/carbon/human/consistent)
	other_ipc.set_species(/datum/species/ipc)
	var/obj/item/clothing/accessory/medal/last_medal = allocate(__IMPLIED_TYPE__)
	ipc_test_pin_medal(last_medal, other_ipc, pinner)
	var/obj/item/bodypart/other_chest = other_ipc.get_bodypart(BODY_ZONE_CHEST)
	qdel(other_chest)
	TEST_ASSERT(!QDELETED(last_medal) && isturf(last_medal.loc), "Deleting the chest deleted or trapped its attached medal.")
	GLOB.commendations.Cut(commendations_before + 1)

/// Losing the chassis while someone is removing an award must cancel the sleeping removal.
/datum/unit_test/ipc_medal_interrupted_removal/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	var/mob/living/carbon/human/pinner = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/remover = allocate(/mob/living/carbon/human/consistent/slow)
	remover.add_or_update_variable_actionspeed_modifier(/datum/actionspeed_modifier/base, multiplicative_slowdown = 1)
	var/obj/item/clothing/accessory/medal/medal = allocate(__IMPLIED_TYPE__)
	var/commendations_before = length(GLOB.commendations)
	ipc_test_pin_medal(medal, ipc, pinner)
	var/datum/component/ipc_medals/mount = ipc.GetComponent(/datum/component/ipc_medals)
	TEST_ASSERT(mount, "The interrupted removal fixture could not pin its award.")
	addtimer(CALLBACK(src, PROC_REF(change_species), ipc), 1 SECONDS)
	TEST_ASSERT(!mount.remove_medal(medal, remover), "Removal completed after the chassis component was deleted during its delay.")
	TEST_ASSERT(QDELETED(mount), "The interruption did not remove the chassis component.")
	TEST_ASSERT(isturf(medal.loc) && !remover.is_holding(medal), "The stale removal teleported the dropped award into the remover's hands.")
	GLOB.commendations.Cut(commendations_before + 1)

/datum/unit_test/ipc_medal_interrupted_removal/proc/change_species(mob/living/carbon/human/ipc)
	ipc.set_species(/datum/species/human)

/// Prefill the existing prompt, but exercise the real pinnable component and delay.
/datum/unit_test/proc/ipc_test_pin_medal(obj/item/clothing/accessory/medal/medal, mob/living/carbon/human/recipient, mob/living/carbon/human/pinner)
	var/obj/item/held = pinner.get_active_held_item()
	if(held && held != medal)
		pinner.dropItemToGround(held)
	if(pinner.get_active_held_item() != medal)
		pinner.put_in_active_hand(medal)
	medal.commendation_message = "Unit test commendation"
	var/datum/component/pinnable_accessory/pinnable = medal.GetComponent(/datum/component/pinnable_accessory)
	pinnable.on_pre_pin = null
	pinnable.try_to_pin(medal, recipient, pinner)
